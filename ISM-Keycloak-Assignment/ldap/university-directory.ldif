dn: cn=lecturer,ou=groups,dc=university,dc=local
objectClass: groupOfNames
cn: lecturer
description: Teaching staff
member: uid=lecturer02,ou=people,dc=university,dc=local

dn: cn=student,ou=groups,dc=university,dc=local
